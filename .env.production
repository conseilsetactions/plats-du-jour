# Version en ligne (Vercel)
# Mode démo : module « Démo » (heure et GPS simulés, établissements fictifs), SIRET de test,
# et site non référencé par les moteurs de recherche.
# >>> Passer à false au moment du vrai lancement, puis republier <<<
VITE_DEMO_MODE=true

# Mesure d'audience réelle (Umami, sans cookie) : coller ici l'identifiant du site
# (Umami > Settings > Websites > Edit > Website ID), puis republier. Vide = désactivé
VITE_UMAMI_WEBSITE_ID=
